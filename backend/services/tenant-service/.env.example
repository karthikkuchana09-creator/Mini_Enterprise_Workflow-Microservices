# Internal service-to-service auth (used by shared/ when services split)
INTERNAL_API_KEY=replace_with_secure_internal_api_key
AUTH_SERVICE_URL=http://auth-service:8001

# Database
DATABASE_URL=mysql+pymysql://tenant_user:tenant_password@mysql:3306/ecwf_tenant_db

# JWT (validate tokens issued by auth-service)
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:3000"]