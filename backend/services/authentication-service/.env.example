# Application
APP_NAME=ECWF Tool
APP_VERSION=1.0.0
DEBUG=True

# Database
DATABASE_URL=url

# Security / JWT
# REQUIRED: change to a strong random value in production
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=ecwf-auth
# Access token expiry in minutes (between 15 and 30)
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token expiry in days (between 7 and 30)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email classification
# Personal/free-mail domains (allowed for Individual, rejected for Organization)
PERSONAL_EMAIL_DOMAINS=["gmail.com","yahoo.com","outlook.com","hotmail.com","icloud.com"]

# OTP
# OTP validity in minutes
OTP_EXPIRE_MINUTES=5
# OTP JWT expiry in minutes
OTP_TOKEN_EXPIRE_MINUTES=5
# Maximum OTP verification attempts before invalidation
OTP_MAX_ATTEMPTS=3
OTP_LENGTH=6
# Minimum cooldown (seconds) between OTP resends
OTP_RESEND_COOLDOWN_SECONDS=60
# Abuse guard: max OTP issues per email+purpose inside the resend window
OTP_MAX_RESENDS=5
OTP_RESEND_WINDOW_MINUTES=10

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_NUMBER=True
PASSWORD_REQUIRE_SPECIAL=True

# Cookies
COOKIE_DOMAIN=
# Set True in production (HTTPS)
COOKIE_SECURE=True
COOKIE_HTTPONLY=True
COOKIE_SAMESITE=strict
COOKIE_PATH=/
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
OTP_TOKEN_COOKIE_NAME=otp_token
# Password-reset state cookie + validity in minutes (window after OTP verify)
RESET_TOKEN_COOKIE_NAME=reset_token
RESET_TOKEN_EXPIRE_MINUTES=10

# Internal service-to-service auth (used by shared/ when services split)
INTERNAL_API_KEY=replace_with_secure_internal_api_key
TENANT_SERVICE_URL=http://tenant-service:8003
NOTIFICATION_SERVICE_URL=http://notification-service:8004

# Email / Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# CORS
CORS_ORIGINS=["http://localhost:3000"]